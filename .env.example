# ==========================================
# AirInbox / TempMail - Environment Configuration (Dokploy)
# ==========================================

# Project Namespace (Avoid container name collisions)
COMPOSE_PROJECT_NAME=airinbox

# Allowed domains for temp emails (comma separated)
DOMAINS=correos.abadgroup.tech

# Enable dynamic wildcard subdomains (e.g. user@x7k.correos.abadgroup.tech)
ENABLE_RANDOM_SUBDOMAINS=true

# Authentication & Demo User
AUTH_ENABLED=true
DEMO_USER=demo
DEMO_PASSWORD=demo1234
SESSION_LIFESPAN_MINUTES=60

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=abadgroup_secret_db_pass_2026
POSTGRES_DB=tempmail

# Custom Host Ports (all ending in 12 to avoid collisions)
FRONTEND_PORT=3012
BACKEND_PORT=8012
POSTGRES_PORT=54312
SMTP_PORT=2512

# Public URL config
VITE_API_BASE_URL=/api
