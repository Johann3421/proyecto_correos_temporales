# ==========================================
# AirInbox / TempMail - Environment Configuration (Dokploy)
# ==========================================

# Project Namespace (Avoid container name collisions)
COMPOSE_PROJECT_NAME=airinbox

# Allowed domains for temp emails (comma separated)
DOMAINS=correos.abadgroup.tech

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=abadgroup_secret_db_pass_2026
POSTGRES_DB=tempmail

# Custom Host Ports (avoiding default collisions with *12 suffix)
FRONTEND_PORT=3012
BACKEND_PORT=8012
POSTGRES_PORT=54312
SMTP_ALT_PORT=2512
SMTP_REAL_PORT=25

# Public URL config
VITE_API_BASE_URL=/api
