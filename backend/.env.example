# ==========================================
# AirInbox / TempMail - Environment Configuration
# ==========================================

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecurepassword123
POSTGRES_DB=tempmail

# Allowed domains for temp emails (comma separated)
DOMAINS=midominio.com,temp.midominio.com

# SMTP Receiver Port Configuration
SMTP_HOST=0.0.0.0
SMTP_PORT=2525

# Frontend Public API Base URL (Used for production builds if needed)
VITE_API_BASE_URL=/api
